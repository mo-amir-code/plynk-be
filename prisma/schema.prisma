generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum OwnerType {
  ADMIN
  USER
}

enum ThemeType {
  SHOP
  LINKS
}

enum WidgetType {
  GITHUB
  LINKEDIN
  INSTAGRAM
  PORTFOLIO
  FACEBOOK
  YOUTUBE
  TWITTER
  TIKTOK
  DRIBBBLE
  CUSTOM
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String?   @unique
  passwordHash String
  fullName     String?
  role         OwnerType @default(USER)
  tnc          Boolean   @default(false)
  resetToken        String?   @unique
  resetTokenExpires DateTime?
  isVerified          Boolean   @default(false)
  verificationCode    String?
  verificationExpires DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  page   Page?    // A user can have only one page.
  themes Theme[]  // themes created by user
  assets Asset[]  // assets uploaded by user

  @@map("users")
}

model Page {
  id          String   @id @default(uuid())
  createdBy   String   @unique
  user        User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  title       String
  themeId     String
  theme       Theme    @relation(fields: [themeId], references: [id])
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  widgets Widget[]

  @@map("pages")
}

model Theme {
  id          String    @id @default(uuid())
  name        String
  ownerType   OwnerType
  type        ThemeType
  description String
  styleConfig Json      @default("{}") // jsonb
  createdBy   String?   // optional if ownerType is admin
  user        User?     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime  @default(now())

  pages Page[]

  @@map("themes")
}

model Widget {
  id        String     @id @default(uuid())
  pageId    String
  page      Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      WidgetType
  handle    String
  fullURL   String     // when type is equal to custom
  startCol  Int
  startRow  Int
  colSize   Int
  rowSize   Int
  icon      String?    // assets URL optional in custom type condition
  config    Json       @default("{}") // { "data": {}, "options": {} }
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("widgets")
}

enum AssetCategory {
  IMAGE
  STICKER
}

model Asset {
  id         String        @id @default(uuid())
  url        String
  category   AssetCategory @default(IMAGE)
  metadata   Json?         @default("{}") // Store sizes, alt text, or sticker tags here
  ownerType  OwnerType
  uploadedBy String?   // optional if ownerType is admin
  user       User?     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@map("assets")
}
